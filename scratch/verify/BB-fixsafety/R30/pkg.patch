+        """
+        Internal handler for loading failed events.
+        :param event: The loading failed event.
+        """
+        if event.request_id == self.request_id:
+            self._teardown()
+            exception = ProtocolException(f"loading failed: {event.error_text}")
+            for future in (self.response_future, self.loading_finished_future):
