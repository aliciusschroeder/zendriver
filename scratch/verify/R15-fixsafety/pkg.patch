+def remove_duplicate_args(args: list[str]) -> list[str]:
+    """Drop repeated identical args, keeping the last copy because Chrome uses the last value of a switch."""
+    result: list[str] = []
+    seen: set[str] = set()
+    for arg in reversed(args):
+        if arg not in seen:
+            seen.add(arg)
+            result.append(arg)
+    result.reverse()
+    return result
