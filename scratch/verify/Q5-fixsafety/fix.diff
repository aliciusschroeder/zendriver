+class _StderrTail:
+    """
+    Keep reading the stderr of a browser process in a background thread.
+
+    Nothing else reads the pipe while the browser runs, and a browser whose
+    pipe is full (64 KiB on Linux) blocks on its next log write and stops
+    answering CDP. Only the last ``size`` bytes are kept, so they can be shown
+    when the browser fails to start.
+    """
+
+    def __init__(self, stream: typing.IO[bytes], size: int = 2**16) -> None:
+        self._size = size
+        self._data = bytearray()
+        self._lock = threading.Lock()
+        self._thread = threading.Thread(
+            target=self._drain,
+            args=(stream,),
+            name="zendriver-browser-stderr",
+            daemon=True,
+        )
+        self._thread.start()
+
+    def _drain(self, stream: typing.IO[bytes]) -> None:
+        # this thread owns the stream and closes it once the browser closed its end
+        try:
+            while chunk := os.read(stream.fileno(), 2**16):
+                with self._lock:
+                    self._data += chunk
+                    del self._data[: -self._size]
+        except (OSError, ValueError):
+            pass
+        finally:
+            stream.close()
+
+    async def read(self, n: int, timeout: float) -> bytes:
+        # give the thread a moment to read what an exiting browser wrote last
+        await asyncio.to_thread(self._thread.join, timeout)
+        with self._lock:
+            return bytes(self._data[max(0, len(self._data) - n) :])
