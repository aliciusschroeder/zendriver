     @property
+    def _download_behavior(self) -> List[str] | None:
+        """
+        the download behavior zendriver set for the browser context of this target.
+        the browser applies it to the whole context, so it is shared by its targets.
+        """
+        if self._owner is not None:
+            return self._owner._download_behaviors.get(self.browser_context_id)
+        return self._own_download_behavior
+
+    @_download_behavior.setter
+    def _download_behavior(self, value: List[str] | None) -> None:
+        if self._owner is not None:
+            self._owner._download_behaviors[self.browser_context_id] = value
+        else:
+            self._own_download_behavior = value
+
+    def _count_download_expectations(self, delta: int = 0) -> int:
+        """
+        add delta to the number of active download expectations of the browser
+        context of this target, and return that number
+        """
+        counts = (
+            self._owner._download_expectations
+            if self._owner is not None
+            else self._own_download_expectations
+        )
+        count = counts.get(self.browser_context_id, 0) + delta
+        counts[self.browser_context_id] = count
+        return count
+
+    async def _set_download_behavior(
+        self, behavior: str, download_path: str | None = None
+    ) -> None:
+        """
+        set the download behavior of the browser context of this target, with the
+        download events enabled (an expectation may be waiting for them)
+        """
+        browser_context_id = None
+        context_id = self.browser_context_id
+        browser_connection = self._owner.connection if self._owner else None
+        if context_id is not None and browser_connection is not None:
+            # the command applies to the default context unless it names another
+            # one, and it does not accept the id of the default context
+            context_ids, _ = await browser_connection.send(
+                cdp.target.get_browser_contexts()
+            )
+            if context_id in context_ids:
+                browser_context_id = context_id
+        await self.send(
+            cdp.browser.set_download_behavior(
+                behavior=behavior,
+                browser_context_id=browser_context_id,
+                download_path=download_path,
+                events_enabled=True,
+            )
+        )
+
+    @property
     def target(self) -> cdp.target.TargetInfo | None:
