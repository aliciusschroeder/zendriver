                  "how": "probe_real.py: browser.stopped=False and os.kill(pid,0) plus /proc state shows the pid alive right after the block"
                }
              ],
              "realism": "high",
              "severity": "wrong-result",
              "fix_assessment": {
                "kind": "minimal-local",
