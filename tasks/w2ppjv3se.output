                "prototype_dir": "/tmp/claude-0/-home-user-zendriver/b2021b39-94e6-5220-9e66-7f33c0314a80/scratchpad/verify/BB-fixsafety/R27/pkg",
                "diff_summary": "util.cdp_get_module: in the AttributeError branch, before falling back to importlib.import_module, look the name up underscore- and case-insensitively among the module attributes of zendriver.cdp (name.replace('_','') == domain.replace('_','').lower()) and return the match. 'webauthn' maps to web_authn, 'indexeddb' to indexed_db and 'input' to input_. No collisions exist among the cdp module names.",
                "regression_test_path": "/tmp/claude-0/-home-user-zendriver/b2021b39-94e6-5220-9e66-7f33c0314a80/scratchpad/verify/BB-fixsafety/tests/test_r27.py",
                "fails_on_repo": "yes",
