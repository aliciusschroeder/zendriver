                }
              ],
              "realism": "medium",
              "severity": "wrong-result",
              "fix_assessment": {
                "kind": "minimal-local",
                "prototype_dir": "",
                "diff_summary": "",
                "regression_test_path": "",
                "fails_on_repo": "not-run",
                "passes_on_prototype": "not-run",
