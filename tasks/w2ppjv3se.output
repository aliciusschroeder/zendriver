                  "status": "verified",
                  "how": "--user-agent in both browser_args and user_agent; Browser.getVersion returned the later (Config attribute) value"
                },
                {
                  "claim": "The webrtc policy set in user browser_args is overridden by Config's default disable_webrtc flags",
                  "status": "assumed",
